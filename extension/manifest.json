{
  "manifest_version": 3,
  "name": "AI Viewer",
  "version": "2.1.1",
  "description": "여러 AI 채팅에 한 번에 질문하고 답변을 나란히 비교합니다.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "AI Viewer 열기",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["declarativeNetRequest", "storage", "favicon"],
  "host_permissions": [
    "https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://*.openai.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://www.meta.ai/*", "https://*.meta.ai/*",
    "https://accounts.google.com/*", "https://auth.meta.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://www.meta.ai/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["login.html", "login.js"],
      "matches": [
        "https://chatgpt.com/*", "https://*.chatgpt.com/*", "https://*.openai.com/*",
        "https://gemini.google.com/*", "https://accounts.google.com/*",
        "https://claude.ai/*",
        "https://*.meta.ai/*", "https://auth.meta.com/*"
      ]
    }
  ]
}
